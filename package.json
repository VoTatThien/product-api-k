{
  "name": "product-api",
  "version": "1.0.0",
  "description": "RESTful API CRUD for Product using Mongoose & MongoDB with Docker, CI/CD",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:unit": "jest tests/simple.test.js --runInBand --forceExit --verbose",
    "test": "jest tests/product.test.js --runInBand --forceExit --detectOpenHandles --verbose",
    "test:all": "jest --runInBand --forceExit --detectOpenHandles --verbose"
  },
  "keywords": [
    "product",
    "api",
    "crud",
    "mongodb",
    "mongoose",
    "docker",
    "docker-compose",
    "ci-cd",
    "github-actions"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
